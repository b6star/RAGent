rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isOwner(projectId) {
      return signedIn() && project(projectId).data.ownerId == request.auth.uid;
    }

    function isMember(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function isAdmin(projectId) {
      return isMember(projectId)
        && get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role == 'Admin';
    }

    function hasValidPublicSourceLinks() {
      return request.resource.data.keys().hasAll(['githubUrl', 'docsUrl'])
        && request.resource.data.githubUrl is string
        && request.resource.data.docsUrl is string
        && request.resource.data.githubUrl.size() <= 2048
        && request.resource.data.docsUrl.size() <= 2048
        && (request.resource.data.githubUrl == ''
          || request.resource.data.githubUrl.matches('^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'))
        && (request.resource.data.docsUrl == ''
          || request.resource.data.docsUrl.matches('^https://(([A-Za-z0-9-]+\\.)*notion\\.site|([A-Za-z0-9-]+\\.)*notion\\.so|app\\.notion\\.com)/[^\\s?#]+$'));
    }

    function sourceLinkChangeIsAuthorized(projectId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['githubUrl', 'docsUrl'])
        || (isAdmin(projectId) && hasValidPublicSourceLinks());
    }

    function invite(projectId, inviteId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/invites/$(inviteId));
    }

    function hasValidInvite(projectId, inviteId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/invites/$(inviteId))
        && invite(projectId, inviteId).data.projectId == projectId
        && invite(projectId, inviteId).data.role in ['Member', 'Viewer'];
    }

    function hasNoServerManagedAiChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'totalAiInputTokens',
        'totalAiOutputTokens',
        'totalAiThoughtsTokens',
        'totalAiTokens',
        'personalAiUsageCount',
        'developerAiUsageCount',
        'developerAiTotalTokens',
        'lastAiUsageAt'
      ]);
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny([
          'totalAiInputTokens',
          'totalAiOutputTokens',
          'totalAiThoughtsTokens',
          'totalAiTokens',
          'personalAiUsageCount',
          'developerAiUsageCount',
          'developerAiTotalTokens',
          'lastAiUsageAt'
        ]);
      allow update: if isUser(userId) && hasNoServerManagedAiChanges();
      allow delete: if false;
    }

    match /users/{userId}/ai_usage/{usageId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidPublicSourceLinks();

      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.visibility == 'Public'
          || isMember(projectId));

      allow update: if sourceLinkChangeIsAuthorized(projectId) && (isAdmin(projectId) || (
        isOwner(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
      ));

      allow delete: if isAdmin(projectId) || isOwner(projectId);
    }

    match /projects/{projectId}/members/{userId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || isMember(projectId)
        || isOwner(projectId)
      );

      allow create: if signedIn()
        && request.resource.data.userId == userId
        && request.resource.data.role in ['Admin', 'Member', 'Viewer']
        && ((isAdmin(projectId)
          && request.resource.data.role in ['Member', 'Viewer']) || (
          isOwner(projectId)
          && userId == request.auth.uid
          && request.resource.data.role == 'Admin'
        ) || (
          userId == request.auth.uid
          && hasValidInvite(projectId, request.resource.data.inviteId)
          && request.resource.data.role == invite(projectId, request.resource.data.inviteId).data.role
        ));

      allow update: if isAdmin(projectId)
        && request.resource.data.userId == resource.data.userId
        && resource.data.role in ['Member', 'Viewer']
        && request.resource.data.role in ['Member', 'Viewer'];

      allow delete: if (isAdmin(projectId)
        && resource.data.role in ['Member', 'Viewer'])
        || (isOwner(projectId)
          && resource.data.role == 'Admin'
          && !existsAfter(/databases/$(database)/documents/projects/$(projectId)))
        || (signedIn()
          && userId == request.auth.uid
          && resource.data.role in ['Member', 'Viewer']
          && project(projectId).data.ownerId != request.auth.uid);
    }

    match /{path=**}/members/{userId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /projects/{projectId}/invites/{inviteId} {
      allow get: if signedIn();
      allow list: if isOwner(projectId) || isAdmin(projectId);
      allow create, delete: if isAdmin(projectId);
    }

    match /projects/{projectId}/comments/{commentId} {
      allow read: if isMember(projectId);
      allow create: if isMember(projectId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if (isMember(projectId)
        && resource.data.authorId == request.auth.uid)
        || isAdmin(projectId);
    }

    // Member-readable source synchronization status and manifest metadata.
    // Server-only control and job documents remain denied by default.
    match /projects/{projectId}/sourceSync/status {
      allow read: if isOwner(projectId) || isMember(projectId);
      allow write: if false;
    }

    match /projects/{projectId}/sources/{sourceType} {
      allow read: if isOwner(projectId) || isMember(projectId);
      allow write: if false;
    }

    match /users/{userId}/ai_chats/{projectId}/sessions/{sessionId} {
      allow read, write: if isUser(userId);
    }

    match /users/{userId}/ai_chats/{projectId}/sessions/{sessionId}/messages/{messageId} {
      allow read, write: if isUser(userId);
    }

    // Any collection not explicitly listed above is denied by default.
  }
}
